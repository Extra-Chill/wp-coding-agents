<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wp.roadie</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/roadie</string>
        <string>--data-dir</string>
        <string>/home/chubes/.roadie</string>
        <string>--auto-restart</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/var/www/site</string>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/home/chubes/.roadie/roadie.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/home/chubes/.roadie/roadie.stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/home/chubes/.local/bin:/opt/homebrew/bin:/home/chubes/.opencode/bin:/home/chubes/.bun/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>ROADIE_DATA_DIR</key>
        <string>/home/chubes/.roadie</string>
        <key>ROADIE_MANAGED</key>
        <string>1</string>
        <key>ROADIE_NO_DEFAULT_CHANNEL</key>
        <string>1</string>
        <key>ROADIE_PROMPT_CONFIG</key>
        <string>/home/chubes/.roadie/roadie-config/prompt-config.yaml</string>
        <key>ROADIE_PLUGINS</key>
        <string>/home/chubes/.roadie/roadie-config/roadie-plugins/host-upgrade.mjs,/home/chubes/.roadie/roadie-config/roadie-plugins/fork-workspace.mjs</string>
        <key>ROADIE_SERVICE_TOKEN_FILE</key>
        <string>/home/chubes/.roadie/secrets/send-token</string>
        <key>DATAMACHINE_SITE_PATH</key>
        <string>/var/www/site</string>
        <key>DATAMACHINE_WP_TRANSPORT_JSON</key>
        <string>["wp"]</string>
        <key>DATAMACHINE_AGENT_SLUG</key>
        <string>intelligence-chubes4</string>
    </dict>
</dict>
</plist>
